# EventServer Production Environment Configuration
# Copy this file to .env.production and update the values

# Security Configuration
JWT_SECRET=your-secure-jwt-secret-here-change-this-in-production
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your-secure-minio-password-here-change-this-in-production

# Server Configuration
SERVER_ADDRESS=https://your-domain.com

# Frontend Configuration
VITE_API_BASE_URL=https://your-domain.com

# Storage Configuration
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=your-secure-minio-password-here-change-this-in-production
S3_REGION=us-east-1
S3_BUCKET=eventserver-storage
S3_USE_PATH_STYLE=true
S3_ENABLE_SSL=false
S3_UPLOAD_TIMEOUT=300
S3_MAX_FILE_SIZE=104857600
S3_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,video/mp4

# Development Configuration (for dev profile)
# Uncomment and modify these for development
# SERVER_ADDRESS=http://localhost:3001
# VITE_API_BASE_URL=http://localhost:3001
