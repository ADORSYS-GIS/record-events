# EventServer Local Development Environment Configuration
# Copy this file to .env.local and update the values if needed

# Security Configuration (optional for local development)
JWT_SECRET=dummy_jwt_secret_for_development_only
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Server Configuration
SERVER_ADDRESS=http://localhost:3000

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:3000

# Storage Configuration
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET=eventserver-storage
S3_USE_PATH_STYLE=true
S3_ENABLE_SSL=false
S3_UPLOAD_TIMEOUT=300
S3_MAX_FILE_SIZE=104857600
S3_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,video/mp4
